{
  "name": "fore-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for FORe (Foresight BI Desktop) documentation - provides AI assistants with access to 4900+ interfaces and 42000+ documentation pages",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "index:examples": "tsx scripts/build-code-examples-index.ts",
    "index:guides": "tsx scripts/build-guides-index.ts",
    "index:members": "tsx scripts/build-members-index.ts",
    "index:fulltext": "tsx scripts/build-fulltext-index.ts",
    "index:all": "npm run index:examples && npm run index:guides && npm run index:members && npm run index:recipes && npm run index:fulltext",
    "index:recipes": "tsx scripts/build-task-recipes-catalog.ts",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "foresight",
    "fore",
    "documentation",
    "ai",
    "assistant"
  ],
  "author": "ForeCode",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0"
  },
  "bin": {
    "fore-mcp-server": "./dist/index.js"
  }
}

